{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Represents a potential customer lead from the contact form.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the lead"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the lead"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the lead"
        },
        "service": {
          "type": "string",
          "description": "The service they are interested in"
        },
        "message": {
          "type": "string",
          "description": "Optional message from the lead"
        },
        "status": {
          "type": "string",
          "enum": ["New", "Contacted", "Converted", "Lost"],
          "description": "Current status of the lead"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the lead was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the lead was last updated"
        }
      },
      "required": ["name", "email", "phone", "service", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of customer leads."
    }
  }
}
